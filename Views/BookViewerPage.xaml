<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.BookViewerPage"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top bar (green) -->
        <Grid Grid.Row="0" BackgroundColor="#8BC34A" Padding="12,10"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"/>

            <Label x:Name="BookTitleLabel"
                   Grid.Column="1"
                   Text=""
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>

            <Label Grid.Column="2"
                   Text=""
                   WidthRequest="40"/>
        </Grid>

        <!-- Toolbar (light gray, scrollable) -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="#F5F5F5">
            <HorizontalStackLayout Padding="8,6" Spacing="6">
        
                <Button x:Name="PrevButton"
                        Text="Prev"
                        Clicked="OnPrevClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Label x:Name="PageInfoLabel"
                       Text="0 / 0"
                       TextColor="#666"
                       FontSize="13"
                       VerticalOptions="Center"
                       WidthRequest="60"
                       HorizontalTextAlignment="Center"/>
        
                <Button x:Name="NextButton"
                        Text="Next"
                        Clicked="OnNextClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="GridButton"
                        Text="Grid"
                        Clicked="OnGridClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="TeacherNotesButton"
                        Text="Notes"
                        Clicked="OnTeacherNotesClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="StudentAnswersButton"
                        Text="Answers"
                        Clicked="OnStudentAnswersClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="DecryptButton"
                        Text="Decrypt"
                        Clicked="OnDecryptClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="SideBySideButton"
                        Text="1 Page"
                        Clicked="OnSideBySideClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="ViewModeButton"
                        Text="View"
                        Clicked="OnViewModeClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="ExportPdfButton"
                        Text="PDF"
                        Clicked="OnExportPdfClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"
                        IsEnabled="False"/>
        
                <Button x:Name="ZoomOutButton"
                        Text="-"
                        Clicked="OnZoomOutClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"/>
        
                <Label x:Name="ZoomLabel"
                       Text="1.0x"
                       TextColor="#666"
                       FontSize="13"
                       VerticalOptions="Center"
                       WidthRequest="45"
                       HorizontalTextAlignment="Center"/>
        
                <Button x:Name="ZoomInButton"
                        Text="+"
                        Clicked="OnZoomInClicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="#333"
                        FontSize="13"
                        Padding="12,6"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Content area -->
        <Grid Grid.Row="2" BackgroundColor="#E8E8E8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <WebView x:Name="ContentWebView"
                     Grid.Column="0"
                     BackgroundColor="#E8E8E8"/>

            <WebView x:Name="NextPageWebView"
                     Grid.Column="1"
                     BackgroundColor="#E8E8E8"
                     IsVisible="False"/>

            <WebView x:Name="TeacherWebView"
                     Grid.Column="1"
                     BackgroundColor="Transparent"
                     IsVisible="False"/>

            <WebView x:Name="StudentWebView"
                     Grid.Column="1"
                     BackgroundColor="Transparent"
                     IsVisible="False"/>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" BackgroundColor="#F5F5F5" Padding="12,6">
            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="#666"
                   FontSize="11"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
