<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.BookViewerPage"
             Title="Book Viewer"
             BackgroundColor="#ffffff">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (scrollable for small screens) -->
        <ScrollView Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="#cccccc">
            <Grid Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation group -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back button -->
                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Text="◀"
                            Clicked="OnBackClicked"
                            BackgroundColor="#34495e"
                            TextColor="White"
                            Padding="10,6"/>

                    <Button x:Name="PrevButton" 
                            Grid.Column="0"
                            Text="◀" 
                            Clicked="OnPrevClicked"
                            BackgroundColor="#34495e"
                            TextColor="White"
                            IsEnabled="False"
                            Padding="10,6"/>

                    <Label x:Name="PageInfoLabel" 
                           Grid.Column="1"
                           Text="0 / 0"
                           TextColor="#8899bb"
                           FontSize="14"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Padding="8,0"
                           WidthRequest="60"/>

                    <Button x:Name="NextButton" 
                            Grid.Column="2"
                            Text="▶" 
                            Clicked="OnNextClicked"
                            BackgroundColor="#34495e"
                            TextColor="White"
                            IsEnabled="False"
                            Padding="10,6"/>
                </Grid>

                <Button x:Name="GridButton" 
                        Grid.Column="1"
                        Text="▦ Grid" 
                        Clicked="OnGridClicked"
                        BackgroundColor="#16a085"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="8,0,0,0"/>

                <Button x:Name="TeacherNotesButton" 
                        Grid.Column="2"
                        Text="Teacher Notes" 
                        Clicked="OnTeacherNotesClicked"
                        BackgroundColor="#3498db"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Button x:Name="StudentAnswersButton" 
                        Grid.Column="3"
                        Text="Student Answers" 
                        Clicked="OnStudentAnswersClicked"
                        BackgroundColor="#2ecc71"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Button x:Name="DecryptButton" 
                        Grid.Column="4"
                        Text="Decrypt" 
                        Clicked="OnDecryptClicked"
                        BackgroundColor="#f39c12"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Button x:Name="SideBySideButton" 
                        Grid.Column="5"
                        Text="1/2" 
                        Clicked="OnSideBySideClicked"
                        BackgroundColor="#2c3e50"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Button x:Name="ViewModeButton" 
                        Grid.Column="6"
                        Text="Content" 
                        Clicked="OnViewModeClicked"
                        BackgroundColor="#2c3e50"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Button x:Name="ExportPdfButton" 
                        Grid.Column="7"
                        Text="PDF" 
                        Clicked="OnExportPdfClicked"
                        BackgroundColor="#9b59b6"
                        TextColor="White"
                        IsEnabled="False"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Button x:Name="ZoomOutButton" 
                        Grid.Column="8"
                        Text="⌕ -" 
                        Clicked="OnZoomOutClicked"
                        BackgroundColor="#2c3e50"
                        TextColor="White"
                        Padding="10,6"
                        Margin="4,0,0,0"/>

                <Label x:Name="ZoomLabel" 
                       Grid.Column="9"
                       Text="1.0x"
                       TextColor="#8899bb"
                       FontSize="14"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Padding="4,0"
                       WidthRequest="40"/>

                <Button x:Name="ZoomInButton" 
                        Grid.Column="10"
                        Text="⌕ +" 
                        Clicked="OnZoomInClicked"
                        BackgroundColor="#2c3e50"
                        TextColor="White"
                        Padding="10,6"
                        Margin="4,0,0,0"/>
            </Grid>
        </ScrollView>

        <!-- Content Area -->
        <Grid Grid.Row="1" BackgroundColor="#2d2d44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            
            <WebView x:Name="ContentWebView" 
                     Grid.Column="0"
                     BackgroundColor="#2d2d44"/>
            
            <WebView x:Name="NextPageWebView" 
                     Grid.Column="1"
                     BackgroundColor="#2d2d44"
                     IsVisible="False"/>
            
            <WebView x:Name="TeacherWebView" 
                     Grid.Column="1"
                     BackgroundColor="Transparent"
                     IsVisible="False"/>
            
            <WebView x:Name="StudentWebView" 
                     Grid.Column="1"
                     BackgroundColor="Transparent"
                     IsVisible="False"/>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" BackgroundColor="#16213e" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label x:Name="StatusLabel" 
                   Grid.Column="0"
                   Text="Ready"
                   TextColor="#8899bb"
                   FontSize="12"
                   LineBreakMode="TailTruncation"/>

            <Label x:Name="BookTitleLabel" 
                   Grid.Column="1"
                   Text="No book"
                   TextColor="#8899bb"
                   FontSize="12"
                   Margin="8,0,0,0"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
