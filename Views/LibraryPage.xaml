<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.LibraryPage"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Grid Grid.Row="0" BackgroundColor="#8BC34A" Padding="16,8"
              ColumnDefinitions="Auto,*,Auto,Auto">
            
            <Image Grid.Column="0"
                   Source="logo.png"
                   HeightRequest="36"
                   Aspect="AspectFit"
                   VerticalOptions="Center"/>

            <Button Grid.Column="2"
                    Text="🔄"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="18"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    VerticalOptions="Center"/>

            <Button Grid.Column="3"
                    Text="⬇"
                    Clicked="OnDownloadClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="18"
                    Padding="10,6"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Book grid -->
        <ScrollView Grid.Row="1">
            <CollectionView x:Name="BooksCollection"
                            Margin="24"
                            SelectionMode="Single"
                            SelectionChanged="OnBookSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="4"
                                     HorizontalItemSpacing="24"
                                     VerticalItemSpacing="24"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout WidthRequest="160" Spacing="10">
                            <Frame Padding="0" CornerRadius="20"
                                   WidthRequest="160" HeightRequest="160"
                                   HorizontalOptions="Center"
                                   BackgroundColor="#FFFFFF"
                                   HasShadow="False"
                                   IsClippedToBounds="True">
                                <Image Source="{Binding CoverImageSource}"
                                       Aspect="AspectFill"
                                       WidthRequest="160" HeightRequest="160"/>
                            </Frame>
                            <Label Text="{Binding DisplayName}"
                                   FontSize="12"
                                   TextColor="#333"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Status bar -->
        <Grid Grid.Row="2" BackgroundColor="#F5F5F5" Padding="12,6">
            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="#666"
                   FontSize="11"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
