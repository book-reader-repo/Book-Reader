<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.LibraryPage"
             BackgroundColor="#FFFFFF">
    <Grid RowDefinitions="Auto,*,Auto">
    
        <!-- Top bar -->
        <Grid Grid.Row="0" BackgroundColor="#8BC34A" Padding="16,8"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              ColumnSpacing="8">
    
            <Label Grid.Column="1"
                   Text="Book Viewer"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
    
            <Button Grid.Column="2"
                    Text=" ↻ Reload"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="18"
                    Padding="10,6"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>
    
            <Button Grid.Column="3"
                    Text="⇓ Batch Download"
                    Clicked="OnBatchDownloadClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="14"
                    Padding="10,6"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>
    
            <Button Grid.Column="4"
                    Text=" ⬇︎ Download"
                    Clicked="OnDownloadClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="18"
                    Padding="10,6"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Book grid -->
        <ScrollView Grid.Row="1">
          <CollectionView x:Name="BooksCollection"
                          Margin="24"
                          SelectionMode="None">
              <CollectionView.ItemsLayout>
                  <GridItemsLayout Orientation="Vertical"
                                   Span="4"
                                   HorizontalItemSpacing="24"
                                   VerticalItemSpacing="24"/>
              </CollectionView.ItemsLayout>
          
              <CollectionView.ItemTemplate>
                  <DataTemplate>
                      <VerticalStackLayout WidthRequest="160"
                                           Spacing="10"
                                           Padding="8"
                                           BackgroundColor="Transparent">
                          <VerticalStackLayout.GestureRecognizers>
                              <TapGestureRecognizer Tapped="OnBookTapped"/>
                          </VerticalStackLayout.GestureRecognizers>
          
                          <Frame Padding="0"
                                 CornerRadius="0"
                                 WidthRequest="160"
                                 HeightRequest="160"
                                 HorizontalOptions="Center"
                                 BackgroundColor="Transparent"
                                 HasShadow="False"
                                 IsClippedToBounds="True"
                                 InputTransparent="True">
                              <Image Source="{Binding CoverImageSource}"
                                     Aspect="AspectFill"
                                     WidthRequest="160"
                                     HeightRequest="200"
                                     InputTransparent="True"/>
                          </Frame>
          
                          <Label Text="{Binding DisplayName}"
                                 FontSize="12"
                                 TextColor="#333"
                                 HorizontalTextAlignment="Center"
                                 LineBreakMode="TailTruncation"
                                 MaxLines="2"
                                 InputTransparent="True"/>
                      </VerticalStackLayout>
                  </DataTemplate>
              </CollectionView.ItemTemplate>
          </CollectionView>
        </ScrollView>

        <!-- Status bar -->
        <Grid Grid.Row="2" BackgroundColor="#F5F5F5" Padding="12,6">
            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="#666"
                   FontSize="11"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Grid>
</ContentPage>
