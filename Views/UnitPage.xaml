<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.UnitPage"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Pink header -->
        <Grid Grid.Row="0" BackgroundColor="#E91E63" Padding="8,10"
              ColumnDefinitions="Auto,*">

            <Button Grid.Column="0"
                    Text="◀"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="18"
                    Padding="12,6"
                    VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   x:Name="UnitTitleLabel"
                   Text=""
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
        </Grid>

        <!-- Unit banner -->
        <Image x:Name="UnitBannerImage"
               Grid.Row="1"
               Aspect="AspectFill"
               HeightRequest="160"
               HorizontalOptions="Fill"
               BackgroundColor="#8BC34A"
               IsVisible="False"/>

        <!-- Tabs -->
        <Grid Grid.Row="2" BackgroundColor="#F5F5F5"
              ColumnDefinitions="Auto,Auto,*">

            <Button x:Name="ContentsTab"
                    Grid.Column="0"
                    Text="Contents"
                    Clicked="OnContentsTabClicked"
                    BackgroundColor="#E0E0E0"
                    TextColor="#333"
                    FontSize="13"
                    Padding="16,10"
                    CornerRadius="0"/>

            <Button x:Name="ResourcesTab"
                    Grid.Column="1"
                    Text="Resources"
                    Clicked="OnResourcesTabClicked"
                    BackgroundColor="Transparent"
                    TextColor="#666"
                    FontSize="13"
                    Padding="16,10"
                    CornerRadius="0"/>
        </Grid>

        <!-- Content area -->
        <Grid Grid.Row="3">

            <!-- Contents view -->
            <ScrollView x:Name="ContentsView" IsVisible="True">
                <CollectionView x:Name="SectionsCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,16" BackgroundColor="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSectionTapped"/>
                                </Grid.GestureRecognizers>
                                <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="#EEEEEE"
                                         VerticalOptions="End" Margin="-20,0"/>
                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="15"
                                       TextColor="#333"/>
                                <Label Grid.Column="1"
                                       Text="{Binding PageStart}"
                                       FontSize="15"
                                       TextColor="#333"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- Resources view -->
            <ScrollView x:Name="ResourcesView" IsVisible="False">
                <VerticalStackLayout>
                    <CollectionView x:Name="ResourcesCollection"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="20,14" BackgroundColor="White" ColumnDefinitions="40,*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResourceTapped"/>
                                    </Grid.GestureRecognizers>
                                    <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="#EEEEEE"
                                             VerticalOptions="End" Margin="-20,0"/>
                                    <Label Grid.Column="0"
                                           Text="{Binding TypeIcon}"
                                           FontSize="18"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#333"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding PageNumber}"
                                           FontSize="14"
                                           TextColor="#666"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
