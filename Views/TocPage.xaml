<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookViewer.Views.TocPage"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto,*">

        <!-- Pink header -->
        <Grid Grid.Row="0" BackgroundColor="#E91E63" Padding="12,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Text="◀" TextColor="White" FontSize="20" 
                   VerticalOptions="Center" Margin="0,0,12,0"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Label.GestureRecognizers>
            </Label>

            <Label x:Name="TitleLabel" Grid.Column="1" 
                   Text="Main Page" TextColor="White" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center"/>

            <Label Grid.Column="2" Text="✏" TextColor="White" FontSize="20" Margin="0,0,16,0"
                   VerticalOptions="Center"/>
            <Label Grid.Column="3" Text="🗑" TextColor="White" FontSize="20"
                   VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Label x:Name="BookTitleLabel" 
                       Text=""
                       FontSize="14" TextColor="#666"
                       Padding="20,16" BackgroundColor="#F5F5F5"/>

                <CollectionView x:Name="UnitsCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnUnitSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,18" BackgroundColor="White">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitTapped"/>
                                </Grid.GestureRecognizers>
                                <BoxView HeightRequest="1" Color="#EEEEEE" 
                                         VerticalOptions="End" Margin="-20,0"/>
                                <Label Text="{Binding Title}" FontSize="16" TextColor="#333"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
