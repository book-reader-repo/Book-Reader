<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Conditionally set target frameworks based on OS -->
        <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net9.0-ios;net9.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(OS)' == 'Unix' AND '$(TargetFramework)' == ''">net9.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(OS)' == 'Unix' AND '$(TargetFramework)' != ''">$(TargetFramework)</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationId>com.oxsolution.abacusviewer</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

        <!-- iOS -->
        <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net9.0-ios'">ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-ios'">14.0</SupportedOSPlatformVersion>
        <CodesignEntitlements Condition="'$(TargetFramework)' == 'net9.0-ios'">oxsolution.entitlements</CodesignEntitlements>

        <!-- Android -->
        <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net9.0-android'">android-arm64;android-x64;android-arm</RuntimeIdentifiers>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-android'">21.0</SupportedOSPlatformVersion>
        
        <!-- Android specific -->
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <AndroidUseAapt2>true</AndroidUseAapt2>
        <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
        <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
        <AndroidEnableAot>false</AndroidEnableAot>
    </PropertyGroup>

    <!-- iOS specific items -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-ios'">
        <BundleResource Include="Platforms\iOS\**\*" />
    </ItemGroup>

    <!-- Android specific items - Only include resource files, NOT source files -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
        <AndroidResource Include="Platforms\Android\Resources\**\*" />
        <AndroidResource Include="Platforms\Android\AndroidManifest.xml" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Exclude Android files when building for iOS and vice versa -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-ios'">
        <Compile Remove="Platforms\Android\**\*.cs" />
        <None Remove="Platforms\Android\**\*.cs" />
        <Compile Remove="Platforms\Android\**\*.xml" />
        <None Remove="Platforms\Android\**\*.xml" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
        <Compile Remove="Platforms\iOS\**\*.cs" />
        <None Remove="Platforms\iOS\**\*.cs" />
        <Compile Remove="Platforms\iOS\**\*.plist" />
        <None Remove="Platforms\iOS\**\*.plist" />
    </ItemGroup>
</Project>
